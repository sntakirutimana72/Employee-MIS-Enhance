<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<AnchorPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.employeemis.controllers.EmployeesController">
  <BorderPane layoutX="185.0" layoutY="67.0" prefHeight="200.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
    <top>
      <VBox BorderPane.alignment="CENTER">
        <BorderPane.margin>
          <Insets bottom="10.0"/>
        </BorderPane.margin>
        <padding>
          <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
        </padding>
        <HBox prefHeight="16.0">
          <Button onAction="#handleOnCreate" mnemonicParsing="false" text="+ Create New">
            <HBox.margin>
              <Insets right="15.0"/>
            </HBox.margin>
          </Button>
          <Button onAction="#queryTop5Paid" mnemonicParsing="false" text="Top 5 Paid">
            <HBox.margin>
              <Insets right="60.0"/>
            </HBox.margin>
          </Button>
          <AnchorPane>
            <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                  AnchorPane.topAnchor="0.0">
              <AnchorPane maxHeight="1.7976931348623157E308">
                <Label text="Salary Average (By Department)" AnchorPane.bottomAnchor="0.0"
                       AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
              </AnchorPane>
              <ChoiceBox fx:id="salaryAvgByDepartmentSelector" prefWidth="150.0">
                <HBox.margin>
                  <Insets right="5.0"/>
                </HBox.margin>
              </ChoiceBox>
            </HBox>
          </AnchorPane>
        </HBox>
        <Separator prefWidth="200.0">
          <VBox.margin>
            <Insets bottom="10.0" top="10.0"/>
          </VBox.margin>
        </Separator>
        <GridPane prefHeight="16.0">
          <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
          </columnConstraints>
          <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
          </rowConstraints>
          <HBox prefHeight="100.0" prefWidth="200.0">
            <AnchorPane>
              <Label text="Search By" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                     AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
            </AnchorPane>
            <ChoiceBox fx:id="filterBySelector" prefWidth="200">
              <FXCollections fx:factory="observableArrayList">
                <String fx:value="Name"/>
                <String fx:value="Department"/>
                <String fx:value="Performance rate"/>
                <String fx:value="Salary range"/>
              </FXCollections>
            </ChoiceBox>
            <TextField fx:id="filterByNameOrSalaryOrPerformanceField" minWidth="-Infinity"/>
            <ChoiceBox fx:id="filterByDepartmentSelector" prefWidth="200"/>
            <Button onAction="#applyFilterBy" text="Apply" prefWidth="100"/>
          </HBox>
        </GridPane>
      </VBox>
    </top>
    <center>
      <AnchorPane BorderPane.alignment="CENTER">
        <TableView fx:id="employeesTable" layoutX="162.0" layoutY="55.0" AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
          <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
          </columnResizePolicy>
          <columns>
            <TableColumn text="ID">
              <cellValueFactory>
                <PropertyValueFactory property="id"/>
              </cellValueFactory>
            </TableColumn>
            <TableColumn text="Name">
              <cellValueFactory>
                <PropertyValueFactory property="name"/>
              </cellValueFactory>
            </TableColumn>
            <TableColumn text="Department">
              <cellValueFactory>
                <PropertyValueFactory property="department"/>
              </cellValueFactory>
            </TableColumn>
            <TableColumn text="Active">
              <cellValueFactory>
                <PropertyValueFactory property="isActive"/>
              </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="salaryColumn" text="Salary">
              <cellValueFactory>
                <PropertyValueFactory property="salary"/>
              </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="experienceColumn" text="Years of Experience">
              <cellValueFactory>
                <PropertyValueFactory property="yearsOfExperience"/>
              </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="performanceColumn" text="Performance Rate">
              <cellValueFactory>
                <PropertyValueFactory property="performanceRate"/>
              </cellValueFactory>
            </TableColumn>
            <TableColumn text="Creation Date">
              <cellValueFactory>
                <PropertyValueFactory property="createdAt"/>
              </cellValueFactory>
            </TableColumn>
            <TableColumn text="Last Update">
              <cellValueFactory>
                <PropertyValueFactory property="updatedAt"/>
              </cellValueFactory>
            </TableColumn>
          </columns>
        </TableView>
      </AnchorPane>
    </center>
  </BorderPane>
</AnchorPane>
