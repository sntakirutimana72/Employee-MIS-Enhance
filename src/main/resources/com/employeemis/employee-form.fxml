<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefWidth="320.0" spacing="15.0" stylesheets="@../../css/global.css"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.employeemis.controllers.EmployeeFormController">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
  </padding>
  <VBox>
    <VBox.margin>
      <Insets/>
    </VBox.margin>
    <AnchorPane>
      <Label text="Employee name" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
             AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
          <Insets bottom="2.0" left="5.0"/>
        </padding>
      </Label>
    </AnchorPane>

    <TextField fx:id="nameField" promptText="Enter name"/>
  </VBox>
  <VBox>
    <AnchorPane>
      <Label text="Select department" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <padding>
          <Insets bottom="2.0" left="5.0"/>
        </padding>
      </Label>
    </AnchorPane>
    <AnchorPane>
      <ChoiceBox fx:id="departmentSelector" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                 AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
    </AnchorPane>
  </VBox>
  <VBox>
    <AnchorPane>
      <Label text="Salary" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
             AnchorPane.topAnchor="0.0">
        <padding>
          <Insets bottom="2.0" left="5.0"/>
        </padding>
      </Label>
    </AnchorPane>
    <TextField fx:id="salaryField" promptText="Enter salary"/>
  </VBox>
  <VBox>
    <AnchorPane>
      <Label text="Years of experience" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
             AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
          <Insets bottom="2.0" left="5.0"/>
        </padding>
      </Label>
    </AnchorPane>
    <TextField fx:id="experienceField" promptText="Enter years of experience"/>
  </VBox>
  <VBox>
    <AnchorPane>
      <Label text="Performance rate" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
             AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
          <Insets bottom="2.0" left="5.0"/>
        </padding>
      </Label>
    </AnchorPane>
    <TextField fx:id="performanceField" promptText="Enter performance rate"/>
  </VBox>
  <AnchorPane>
    <Label fx:id="errorDisplay" textFill="red" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
           AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
  </AnchorPane>
  <GridPane prefHeight="20.0">
    <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"/>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
    </columnConstraints>
    <rowConstraints>
      <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
    </rowConstraints>
    <Button onAction="#handleSubmit" text="Continue" GridPane.halignment="CENTER"/>
    <Button onAction="#handleCancel" text="Cancel" GridPane.columnIndex="1" GridPane.halignment="CENTER"/>
  </GridPane>
</VBox>
